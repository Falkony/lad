# Optional: without DATABASE_URL an embedded database is created in .data/lad.
# DATABASE_URL=postgres://lad:lad@localhost:5432/lad
# LAD_DATA_DIR=.data/lad
# NITRO_HOST=127.0.0.1

# Automatic JSON backups: startup, every N successful changes and before reset/restore.
# Default directory: backups next to LAD_DATA_DIR (.data/backups by default).
# LAD_BACKUP_DIR=.data/backups
# LAD_BACKUP_EVERY=10
# Minimum 2: preserve the pre-reset/restore copy alongside a new snapshot.
# LAD_BACKUP_KEEP=20
