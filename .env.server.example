# Copy to .env.server (ignored by git). Use your own DNS name with ports 80/443.
LAD_HOSTNAME=finance.example.com
LAD_OWNER_LOGIN=owner
# Generate interactively: npm run auth:hash. Single quotes keep dollar signs literal.
LAD_OWNER_PASSWORD_HASH='REPLACE_WITH_GENERATED_HASH'
# Use separate random hex passwords for the database owner and application role.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
LAD_BACKUP_EVERY=10
LAD_BACKUP_KEEP=30
